{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ur12e-collection:snapshot:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "software_revision": {
      "type": "string",
      "minLength": 1
    },
    "clock_id": {
      "type": "string",
      "minLength": 1
    },
    "clock_epoch": {
      "const": "unix"
    },
    "clock_basis": {
      "enum": [
        "synthetic",
        "realsense_global_time"
      ]
    },
    "clock_validated": {
      "const": false
    },
    "simulated": {
      "type": "boolean"
    },
    "station": {
      "$ref": "urn:ur12e-collection:station:1"
    },
    "calibration": {
      "$ref": "urn:ur12e-collection:station:1#/properties/calibration"
    },
    "cameras": {
      "type": "object",
      "properties": {
        "wrist": {
          "$ref": "#/$defs/camera"
        },
        "third_left": {
          "$ref": "#/$defs/camera"
        },
        "third_right": {
          "$ref": "#/$defs/camera"
        }
      },
      "required": [
        "wrist",
        "third_left",
        "third_right"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "wait_ns": {
          "type": "integer",
          "minimum": 1000000,
          "maximum": 200000000
        },
        "empty_poll_ns": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 10000000
        },
        "depth_verification": {
          "const": "final_file_pixel_hash"
        }
      },
      "required": [
        "wait_ns",
        "empty_poll_ns",
        "depth_verification"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "read_only": {
          "const": true
        },
        "publish_time_basis": {
          "const": "host_receipt_mapped_unix"
        },
        "monotonic_to_unix_ns": {
          "type": "integer"
        },
        "stale_ns": {
          "const": 500000000
        },
        "ur_read_hz": {
          "const": 30
        },
        "hande_poll_interval_ns": {
          "const": 100000000
        },
        "association": {
          "const": "independent_receipts_no_interpolation"
        },
        "devices": {
          "type": "object",
          "properties": {
            "ur": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "transport"
              ]
            },
            "hande": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "transport"
              ]
            }
          },
          "required": [
            "ur",
            "hande"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "read_only",
        "publish_time_basis",
        "monotonic_to_unix_ns",
        "stale_ns",
        "ur_read_hz",
        "hande_poll_interval_ns",
        "association",
        "devices"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "arm_id": {
          "type": "string",
          "minLength": 1
        },
        "leader_id": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "const": "ursim"
        },
        "hande": {
          "const": "bypassed"
        },
        "monotonic_to_unix_ns": {
          "type": "integer"
        },
        "control_hz": {
          "const": 50
        },
        "association": {
          "const": "independent_receipts_no_interpolation"
        },
        "native_home": {
          "type": "object"
        },
        "simulator": {
          "type": "object"
        },
        "camera_queue_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "camera_transport": {
          "enum": [
            "pickle",
            "shared_memory"
          ]
        },
        "writer_queue_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "writer_feedback_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_control_gap_ns": {
          "type": "integer",
          "minimum": 20000000,
          "maximum": 250000000
        },
        "leader_mapping": {
          "const": "episode_relative_conditioned_v1"
        }
      },
      "required": [
        "arm_id",
        "leader_id",
        "command_id",
        "owner_id",
        "backend",
        "hande",
        "monotonic_to_unix_ns",
        "control_hz",
        "association",
        "native_home",
        "simulator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "task",
    "software_revision",
    "clock_id",
    "clock_epoch",
    "clock_basis",
    "clock_validated",
    "simulated",
    "station",
    "calibration",
    "cameras"
  ],
  "additionalProperties": false,
  "$defs": {
    "camera": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "enum": [
            "D405",
            "D435i",
            "D435IF"
          ]
        },
        "depth_scale_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color_intrinsics": {
          "$ref": "#/$defs/intrinsics"
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ]
        },
        "usb": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "model",
        "depth_scale_m",
        "color_intrinsics"
      ],
      "additionalProperties": false
    },
    "intrinsics": {
      "type": "object",
      "properties": {
        "width": {
          "const": 640
        },
        "height": {
          "const": 480
        },
        "fx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ppx": {
          "type": "number"
        },
        "ppy": {
          "type": "number"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "coeffs": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "width",
        "height",
        "fx",
        "fy",
        "ppx",
        "ppy"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "feedback",
          "control"
        ]
      }
    },
    {
      "if": {
        "required": [
          "control"
        ]
      },
      "then": {
        "properties": {
          "simulated": {
            "const": true
          }
        }
      }
    }
  ]
}
